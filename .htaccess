RewriteEngine On
RewriteBase /

# 0. Redirect WWW to Non-WWW and HTTP to HTTPS (301)
RewriteCond %{HTTP_HOST} ^www\.severancecalculator\.xyz$ [NC]
RewriteRule ^(.*)$ https://severancecalculator.xyz/$1 [R=301,L]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 1. Force trailing slash on directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*?[^/])$ %{REQUEST_URI}/ [L,R=301]

# 2. Redirect .html requests to clean URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*\.html\ HTTP/
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# 3. Handle requests without extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

# 4. Special handling for favicon (fallback to png if missing)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^favicon\.ico$ assets/favicon.png [L]

# 5. Custom Error Pages
ErrorDocument 404 /404.html

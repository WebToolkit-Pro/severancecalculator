{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.severancecalculator.xyz"
        }
      ],
      "destination": "https://severancecalculator.xyz/$1",
      "permanent": true
    }
  ]
}
